<!--                <groupId>org.springframework.boot</groupId>-->
<!--                <artifactId>spring-boot-maven-plugin</artifactId>-->
<!--                <configuration>-->
<!--                    <mainClass>com.openchat.OpenChatCustomApplication</mainClass>-->
<!--                    <layout>ZIP</layout>-->
