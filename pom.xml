<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.openchat</groupId>
    <artifactId>openchat</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <modules>
        <module>openchat-chat-server</module>
        <module>openchat-framwork</module>
    </modules>

    <properties>
        <revision>1.0-SNAPSHOT</revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <maven.compiler.proc>full</maven.compiler.proc>
        <spring-boot.version>4.0.8</spring-boot.version>
        <skipTests>true</skipTests>
        <!-- Set DOCKER_HOST to the Docker daemon address used for deployment. -->
        <docker.host>${env.DOCKER_HOST}</docker.host>
        <hutool.version>5.8.47</hutool.version>
        <dynamic-datasource.version>4.5.0</dynamic-datasource.version>
        <mybatis-plus-generator.version>3.5.17</mybatis-plus-generator.version>
        <hdrhistogram.version>2.2.2</hdrhistogram.version>
        <mybatis.version>3.5.19</mybatis.version>
        <mybatis-spring.version>4.0.0</mybatis-spring.version>
        <mysql-connector.version>9.5.0</mysql-connector.version>
        <lombok.version>1.18.48</lombok.version>
        <weixin-java-mp.version>4.8.6-20260919.232150</weixin-java-mp.version>
        <mybatis-plus-boot-starter.version>3.5.17</mybatis-plus-boot-starter.version>
        <okhttp.version>5.3.2</okhttp.version>
        <okhttp-jvm.version>5.5.0</okhttp-jvm.version>
        <redisson-spring-boot-starter.version>4.7.0</redisson-spring-boot-starter.version>
        <minio.version>9.0.3</minio.version>
        <mail.version>2.0.5</mail.version>
        <jsoup.version>1.23.2</jsoup.version>
        <captcha.version>1.6.2</captcha.version>
        <nashorn.version>15.7</nashorn.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <spring-cloud-nacos.version>2025.1.0.0</spring-cloud-nacos.version>
        <springdoc.version>3.1.1</springdoc.version>
        <swagger-annotations.version>2.2.55</swagger-annotations.version>
        <rocketmq-spring.version>2.3.6</rocketmq-spring.version>
        <rocketmq-client-java.version>5.2.2</rocketmq-client-java.version>
        <zxing.version>3.5.4</zxing.version>
        <velocity.version>2.4.1</velocity.version>
        <java-jwt.version>4.6.1</java-jwt.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.openchat</groupId>
                <artifactId>openchat-common-start</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openchat</groupId>
                <artifactId>openchat-oss-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openchat</groupId>
                <artifactId>openchat-transaction</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openchat</groupId>
                <artifactId>openchat-rtc-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp-jvm</artifactId>
                <version>${okhttp-jvm.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus-boot-starter.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-extension</artifactId>
                <version>${mybatis-plus-boot-starter.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
